#!/bin/bash
#
# Update traefik chart in k3s-charts archive to match the version in OBS devel:kubic
#
# This script:
# 1. Extracts the k3s-charts archive
# 2. Queries OBS to find the current traefik version
# 3. Finds the corresponding Helm chart version from traefik's repository
# 4. Updates packages/traefik/package.yaml
# 5. Runs the chart build workflow (with automatic patch regeneration on conflicts)
# 6. Repackages the archive
#

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# OBS project and package
OBS_PROJECT="devel:kubic"
OBS_PACKAGE="traefik"
OBS_URL="https://build.opensuse.org/package/show/${OBS_PROJECT}/${OBS_PACKAGE}"

# Traefik Helm chart repository
TRAEFIK_CHART_INDEX="https://traefik.github.io/charts/index.yaml"
TRAEFIK_CHART_BASE="https://traefik.github.io/charts/traefik"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1" >&2
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1" >&2
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

log_step() {
    echo -e "${BLUE}[STEP]${NC} $1" >&2
}

# Check required tools
check_dependencies() {
    local missing=()
    for cmd in curl grep sed awk tar xz make yq; do
        if ! command -v "$cmd" &> /dev/null; then
            missing+=("$cmd")
        fi
    done

    if [ ${#missing[@]} -ne 0 ]; then
        log_error "Missing required tools: ${missing[*]}"
        if [[ " ${missing[*]} " =~ " yq " ]]; then
            log_info "Install yq: https://github.com/mikefarah/yq#install"
        fi
        exit 1
    fi

    # Check yq version (need v4+)
    local yq_version
    yq_version=$(yq --version 2>&1 | grep -oE '[0-9]+\.[0-9]+' | head -1)
    if [[ "${yq_version%%.*}" -lt 4 ]]; then
        log_error "yq version 4+ required (found: $yq_version)"
        exit 1
    fi
}

# Extract archive and return the extracted directory name
extract_archive() {
    local archive="$1"

    log_info "Extracting archive: $(basename "$archive")"

    # Get the directory name from the archive (first component)
    local dir_name
    dir_name=$(tar -tf "$archive" | head -1 | cut -d'/' -f1)

    # Remove existing extraction if present
    if [ -d "${SCRIPT_DIR}/${dir_name}" ]; then
        log_info "Removing existing extraction: ${dir_name}"
        rm -rf "${SCRIPT_DIR}/${dir_name}"
    fi

    # Extract
    tar -xf "$archive" -C "${SCRIPT_DIR}"

    echo "${SCRIPT_DIR}/${dir_name}"
}

# Repackage the archive
repackage_archive() {
    local extracted_dir="$1"
    local archive="$2"

    local dir_name
    dir_name=$(basename "$extracted_dir")

    log_info "Repackaging archive: $(basename "$archive")"

    # Create new archive
    cd "${SCRIPT_DIR}"
    tar -cJf "$archive" "$dir_name"

    log_info "Archive updated: $(basename "$archive")"
}

# Get traefik version from OBS
get_obs_traefik_version() {
    log_info "Querying OBS for traefik version..."

    local obs_page
    obs_page=$(curl -sL "$OBS_URL")

    if [ -z "$obs_page" ]; then
        log_error "Failed to fetch OBS page"
        exit 1
    fi

    local version
    version=$(echo "$obs_page" | grep -oE 'traefik-v?[0-9]+\.[0-9]+\.[0-9]+' | head -1 | sed 's/traefik-v\?//')

    if [ -z "$version" ]; then
        log_error "Could not extract traefik version from OBS page"
        exit 1
    fi

    echo "$version"
}

# Get the Helm chart version that deploys a specific traefik version
get_chart_version_for_traefik() {
    local traefik_version="$1"

    log_info "Finding Helm chart for traefik v${traefik_version}..."

    local index
    index=$(curl -sL "$TRAEFIK_CHART_INDEX")

    if [ -z "$index" ]; then
        log_error "Failed to fetch traefik Helm chart index"
        exit 1
    fi

    local chart_version
    chart_version=$(echo "$index" | grep -A25 "appVersion: v${traefik_version}" | grep "^    version:" | head -1 | awk '{print $2}')

    if [ -z "$chart_version" ]; then
        chart_version=$(echo "$index" | grep -A25 "appVersion: ${traefik_version}" | grep "^    version:" | head -1 | awk '{print $2}')
    fi

    if [ -z "$chart_version" ]; then
        log_error "Could not find Helm chart for traefik v${traefik_version}"
        log_warn "This might mean OBS has a version that doesn't have a corresponding Helm chart yet."
        log_warn "Available recent traefik versions in Helm charts:"
        echo "$index" | grep "appVersion: v3\." | head -10 >&2
        exit 1
    fi

    echo "$chart_version"
}

# Get current chart URL from package.yaml
get_current_chart_url() {
    local package_yaml="$1"
    grep "^url:" "$package_yaml" | sed 's/url: *//'
}

# Get current chart version from URL
get_current_chart_version() {
    local url="$1"
    echo "$url" | grep -oE 'traefik-[0-9]+\.[0-9]+\.[0-9]+' | sed 's/traefik-//'
}

# Update package.yaml with new chart URL
update_package_yaml() {
    local package_yaml="$1"
    local new_chart_version="$2"
    local new_url="${TRAEFIK_CHART_BASE}/traefik-${new_chart_version}.tgz"

    log_info "Updating package.yaml with chart version ${new_chart_version}..."

    sed -i "s|^url:.*|url: ${new_url}|" "$package_yaml"
    sed -i "s|^packageVersion:.*|packageVersion: 1|" "$package_yaml"

    log_info "Updated package.yaml:"
    cat "$package_yaml" >&2
}

# Regenerate patches using semantic patching
# This is called when make prepare fails due to patch conflicts
regenerate_patches_semantically() {
    local repo_root="$1"
    local chart_version="$2"
    local traefik_version="$3"

    log_step "Regenerating patches using semantic patching..."

    local package_yaml="${repo_root}/packages/traefik/package.yaml"
    local charts_dir="${repo_root}/packages/traefik/charts"
    local k3s_patches_script="${repo_root}/packages/traefik/k3s-patches.sh"

    # Get chart URL from package.yaml
    local chart_url
    chart_url=$(get_current_chart_url "$package_yaml")

    log_info "Downloading fresh upstream chart: $chart_url"

    # Remove old charts directory if exists
    rm -rf "$charts_dir"
    mkdir -p "$charts_dir"

    # Download and extract upstream chart (strip the top-level directory)
    if ! curl -sL "$chart_url" | tar -xz -C "$charts_dir" --strip-components=1; then
        log_error "Failed to download upstream chart"
        return 1
    fi

    log_info "Upstream chart extracted to: $charts_dir"

    # Check if semantic patch script exists
    if [ ! -x "$k3s_patches_script" ]; then
        log_error "Semantic patch script not found or not executable: $k3s_patches_script"
        log_warn "Please ensure packages/traefik/k3s-patches.sh exists"
        return 1
    fi

    # Apply semantic patches
    log_info "Applying k3s semantic patches..."
    if ! "$k3s_patches_script" "$charts_dir" "v${traefik_version}"; then
        log_error "Semantic patching failed"
        return 1
    fi

    log_info "Semantic patches applied successfully"
    return 0
}

# Run the chart build workflow
run_build_workflow() {
    local repo_root="$1"
    local chart_version="$2"
    local traefik_version="$3"
    local force_regenerate="$4"

    log_info "Running chart build workflow..."

    cd "$repo_root"

    export PACKAGE=traefik

    # If force regenerate, skip make prepare and use semantic patching directly
    if [ "$force_regenerate" = true ]; then
        log_info "Force regenerate mode - using semantic patching"
        if ! regenerate_patches_semantically "$repo_root" "$chart_version" "$traefik_version"; then
            log_error "Semantic patching failed"
            exit 1
        fi
    else
        log_info "Running: make prepare"
        if ! make prepare 2>&1; then
            log_warn "make prepare failed - attempting automatic patch regeneration..."
            log_info ""

            # Try semantic patching as fallback
            if ! regenerate_patches_semantically "$repo_root" "$chart_version" "$traefik_version"; then
                log_error "Automatic patch regeneration failed"
                log_warn "Please manually resolve conflicts or update packages/traefik/k3s-patches.sh"
                exit 1
            fi
        fi
    fi

    log_info "Running: make patch"
    if ! make patch; then
        log_error "make patch failed"
        log_warn "The semantic patches may need to be updated for this upstream version"
        exit 1
    fi

    log_info "Running: make clean"
    if ! make clean; then
        log_error "make clean failed"
        exit 1
    fi

    log_info "Running: make charts"
    if ! make charts; then
        log_error "make charts failed"
        exit 1
    fi

    log_info "Build workflow completed successfully"
}

# Show usage
usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS] <archive>

Update traefik chart in k3s-charts archive to match the version in OBS devel:kubic

Arguments:
  <archive>              Path to k3s-charts archive (.tar.xz)

Options:
  -y, --yes              Skip confirmation prompt
  -n, --dry-run          Show what would be done without making changes
  -k, --keep             Keep extracted directory after completion
  -r, --force-regenerate Force regeneration of patches using semantic patching
                         (skips make prepare and applies k3s-patches.sh directly)
  -h, --help             Show this help message

Patch Handling:
  When updating to a new upstream version, the existing .patch files may conflict.
  This script will automatically attempt to regenerate patches using the semantic
  patch script (packages/traefik/k3s-patches.sh) which applies changes based on
  their meaning rather than line positions.

  Use --force-regenerate to always use semantic patching, which is recommended
  when updating across major version bumps.

Example:
  $(basename "$0") k3s-charts-1754298670.5869b83.tar.xz
  $(basename "$0") -y k3s-charts-1754298670.5869b83.tar.xz
  $(basename "$0") -r -y k3s-charts-1754298670.5869b83.tar.xz

EOF
}

# Main
main() {
    local auto_yes=false
    local dry_run=false
    local keep_extracted=false
    local force_regenerate=false
    local archive=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -y|--yes)
                auto_yes=true
                shift
                ;;
            -n|--dry-run)
                dry_run=true
                shift
                ;;
            -k|--keep)
                keep_extracted=true
                shift
                ;;
            -r|--force-regenerate)
                force_regenerate=true
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            -*)
                log_error "Unknown option: $1"
                usage
                exit 1
                ;;
            *)
                # Positional argument - archive file
                if [ -z "$archive" ]; then
                    archive="$1"
                else
                    log_error "Unexpected argument: $1"
                    usage
                    exit 1
                fi
                shift
                ;;
        esac
    done

    # Check archive argument
    if [ -z "$archive" ]; then
        log_error "Missing required argument: <archive>"
        usage
        exit 1
    fi

    # Resolve to absolute path if relative
    if [[ "$archive" != /* ]]; then
        archive="${SCRIPT_DIR}/${archive}"
    fi

    if [ ! -f "$archive" ]; then
        log_error "Archive not found: $archive"
        exit 1
    fi

    log_info "Starting traefik chart update from OBS..."

    check_dependencies

    log_info "Using archive: $(basename "$archive")"

    # Get versions before extraction (for dry-run)
    local obs_version
    obs_version=$(get_obs_traefik_version)
    log_info "OBS traefik version: ${obs_version}"

    local chart_version
    chart_version=$(get_chart_version_for_traefik "$obs_version")
    log_info "Corresponding Helm chart version: ${chart_version}"

    # Extract to check current version
    local extracted_dir
    extracted_dir=$(extract_archive "$archive")
    log_info "Extracted to: $(basename "$extracted_dir")"

    local package_yaml="${extracted_dir}/packages/traefik/package.yaml"

    if [ ! -f "$package_yaml" ]; then
        log_error "package.yaml not found at: $package_yaml"
        exit 1
    fi

    local current_url
    current_url=$(get_current_chart_url "$package_yaml")
    local current_chart_version
    current_chart_version=$(get_current_chart_version "$current_url")

    log_info "Current chart version: ${current_chart_version}"

    if [ "$current_chart_version" = "$chart_version" ]; then
        log_info "Chart is already at version ${chart_version} - no update needed"
        if [ "$keep_extracted" = false ]; then
            rm -rf "$extracted_dir"
        fi
        exit 0
    fi

    log_info "Will update from chart ${current_chart_version} to ${chart_version}"

    if [ "$dry_run" = true ]; then
        log_info "[DRY RUN] Would update package.yaml URL to:"
        log_info "  ${TRAEFIK_CHART_BASE}/traefik-${chart_version}.tgz"
        log_info "[DRY RUN] Would reset packageVersion to 1"
        if [ "$force_regenerate" = true ]; then
            log_info "[DRY RUN] Would force regenerate patches using semantic patching"
        else
            log_info "[DRY RUN] Would run: make prepare (with semantic fallback on conflict)"
        fi
        log_info "[DRY RUN] Would run: make patch && make clean && make charts"
        log_info "[DRY RUN] Would repackage archive"
        if [ "$keep_extracted" = false ]; then
            rm -rf "$extracted_dir"
        fi
        exit 0
    fi

    # Confirm with user
    if [ "$auto_yes" = false ]; then
        echo "" >&2
        if [ "$force_regenerate" = true ]; then
            echo -e "${YELLOW}Note: --force-regenerate will apply semantic patches directly${NC}" >&2
        fi
        read -p "Proceed with update? [y/N] " -n 1 -r
        echo "" >&2
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            log_info "Update cancelled"
            if [ "$keep_extracted" = false ]; then
                rm -rf "$extracted_dir"
            fi
            exit 0
        fi
    fi

    # Perform update
    update_package_yaml "$package_yaml" "$chart_version"
    run_build_workflow "$extracted_dir" "$chart_version" "$obs_version" "$force_regenerate"

    # Repackage
    repackage_archive "$extracted_dir" "$archive"

    # Cleanup
    if [ "$keep_extracted" = false ]; then
        log_info "Cleaning up extracted directory..."
        rm -rf "$extracted_dir"
    else
        log_info "Keeping extracted directory: $(basename "$extracted_dir")"
    fi

    log_info ""
    log_info "=========================================="
    log_info "Update complete!"
    log_info "=========================================="
    log_info "Archive: $(basename "$archive")"
    log_info "New chart version: ${chart_version}"
    log_info "Traefik version: v${obs_version}"
}

main "$@"
